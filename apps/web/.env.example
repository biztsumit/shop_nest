# Where the NestJS API runs. The browser never calls it directly:
# /api/* on this site is forwarded there (see next.config.ts).
API_URL=http://localhost:4000

# Hosts product photos may come from (comma-separated). Default: Cloudinary (uploaded photos)
# and the demo photo hosts. If you set it, keep res.cloudinary.com in the list.
# IMAGE_HOSTS=res.cloudinary.com,picsum.photos,fastly.picsum.photos,images.unsplash.com
