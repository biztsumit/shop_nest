// The database, described in one file. From this, Prisma:
//   - writes the SQL migrations (npm run db:migrate -w @shop/api)
//   - generates a fully typed client into src/generated/prisma (npx prisma generate)
//
// Conventions in this file:
// - Models and fields are named the TypeScript way (ProductVariant, createdAt); @@map/@map give
//   the tables and columns the usual SQL names (product_variants, created_at)
// - ids are UUID version 7: unique like random UUIDs, but they sort by creation time, so new
//   rows go to the end of the index instead of random places (faster inserts)
// - Money is a whole number of paise (₹499.00 = 49900), never a decimal number
// - Rules Prisma can't express (stock >= 0...) are CHECK constraints added to the migration SQL

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  // NestJS 12 apps are ES modules, so the generated client is too
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
  // The connection URL is read from DATABASE_URL by prisma.config.ts
}

// ---------- Catalog ----------

model Category {
  id          String     @id @default(uuid(7)) @db.Uuid
  name        String     @db.VarChar(100)
  slug        String     @unique @db.VarChar(120) // "t-shirts": used in URLs
  description String     @default("")
  // Optional parent, for "Clothing › T-shirts". Deleting a parent keeps its children (they
  // become top level) rather than deleting them.
  parentId    String?    @map("parent_id") @db.Uuid
  parent      Category?  @relation("CategoryTree", fields: [parentId], references: [id], onDelete: SetNull)
  children    Category[] @relation("CategoryTree")
  products    Product[]
  createdAt   DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime   @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([parentId])
  @@map("categories")
}

enum ProductStatus {
  DRAFT // being prepared: only admins see it
  ACTIVE // on sale
  ARCHIVED // no longer sold, but kept: past orders still point at it

  @@map("product_status")
}

model Product {
  id          String           @id @default(uuid(7)) @db.Uuid
  name        String           @db.VarChar(200)
  slug        String           @unique @db.VarChar(220)
  description String           @default("")
  status      ProductStatus    @default(DRAFT)
  // Deleting a category leaves its products uncategorised, never deletes them
  categoryId  String?          @map("category_id") @db.Uuid
  category    Category?        @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  variants    ProductVariant[]
  images      ProductImage[]
  // A SUMMARY of the variants, kept up to date by a database trigger (see the migration
  // *_catalog_listing): the lowest variant price and the total stock. Stored here so the
  // product list can filter and sort by them in one simple, indexed query.
  // Never written by the app: the trigger owns them.
  price       Int              @default(0)
  stock       Int              @default(0)
  createdAt   DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)

  // The product list's orders. ids are UUID v7 (time-ordered), so "newest first" is just id DESC
  @@index([status, id(sort: Desc)])
  @@index([status, price, id])
  @@index([status, name, id])
  @@index([categoryId])
  // Search by name: a trigram index makes `name ILIKE '%tee%'` fast (needs the pg_trgm extension)
  @@index([name(ops: raw("gin_trgm_ops"))], type: Gin, map: "products_name_trgm_idx")
  @@map("products")
}

// What is actually bought: one size/colour combination of a product, with its own price and stock.
// A product without options has exactly one variant with options {}.
model ProductVariant {
  id             String      @id @default(uuid(7)) @db.Uuid
  productId      String      @map("product_id") @db.Uuid
  product        Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  sku            String?     @unique @db.VarChar(64) // the shop's own stock code, optional
  // {"size": "M", "colour": "Black"}
  options        Json        @default("{}")
  // The same options as text in a fixed order ("colour=Black;size=M"), so the database can
  // refuse two variants of one product with identical options (JSON can't be UNIQUE in Prisma)
  optionsKey     String      @default("") @map("options_key") @db.VarChar(255)
  price          Int // paise
  // The "was" price for sales (strikethrough ₹999 → ₹699). Must be higher than price.
  compareAtPrice Int?        @map("compare_at_price")
  stock          Int         @default(0)
  position       Int         @default(0) // display order on the product page
  createdAt      DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime    @updatedAt @map("updated_at") @db.Timestamptz(3)
  cartItems      CartItem[]
  orderItems     OrderItem[]

  @@unique([productId, optionsKey])
  @@map("product_variants")
}

model ProductImage {
  id        String   @id @default(uuid(7)) @db.Uuid
  productId String   @map("product_id") @db.Uuid
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  url       String   @db.VarChar(2000)
  alt       String   @default("") @db.VarChar(300) // what the picture shows, for screen readers
  position  Int      @default(0) // 0 = the main picture
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([productId, position])
  @@map("product_images")
}

// ---------- Accounts ----------

enum Role {
  CUSTOMER
  ADMIN

  @@map("role")
}

model User {
  id              String         @id @default(uuid(7)) @db.Uuid
  // Always stored lower-case (a CHECK constraint makes sure): "Riya@Mail.com" and
  // "riya@mail.com" are the same person, so they can't make two accounts
  email           String         @unique @db.VarChar(254)
  name            String         @db.VarChar(100)
  // An Argon2id hash ("$argon2id$v=19$m=19456,t=2,p=1$..."), never the password itself.
  // It never leaves the API: responses map users to a public shape without it.
  passwordHash    String         @map("password_hash") @db.VarChar(255)
  role            Role           @default(CUSTOMER)
  // When they clicked the link in the verification email (null = not verified yet)
  emailVerifiedAt DateTime?      @map("email_verified_at") @db.Timestamptz(3)
  emailTokens     EmailToken[]
  refreshTokens   RefreshToken[]
  createdAt       DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)
  cartItems       CartItem[]
  addresses       Address[]
  orders          Order[]

  @@map("users")
}

// One row per refresh token ever issued. Only a HASH of the token is stored: a copy of this
// table can't be used to log in as anyone.
// Each login starts a FAMILY; every refresh replaces the token with a new one in the same
// family. If an already-used token comes back, someone has a stolen copy: the family is revoked.
model RefreshToken {
  id        String    @id @default(uuid(7)) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  familyId  String    @map("family_id") @db.Uuid
  tokenHash String    @unique @map("token_hash") @db.Char(64) // SHA-256, as hex
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(3)
  usedAt    DateTime? @map("used_at") @db.Timestamptz(3) // when it was swapped for a new one
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz(3) // logout, or theft detected
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([userId])
  @@index([familyId])
  @@map("refresh_tokens")
}

enum EmailTokenPurpose {
  VERIFY_EMAIL
  RESET_PASSWORD

  @@map("email_token_purpose")
}

// The single-use secrets inside email links ("verify your email", "reset your password").
// Like refresh tokens, only a SHA-256 hash is kept, and each works once, before it expires.
model EmailToken {
  id        String            @id @default(uuid(7)) @db.Uuid
  userId    String            @map("user_id") @db.Uuid
  user      User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  purpose   EmailTokenPurpose
  tokenHash String            @unique @map("token_hash") @db.Char(64)
  expiresAt DateTime          @map("expires_at") @db.Timestamptz(3)
  usedAt    DateTime?         @map("used_at") @db.Timestamptz(3)
  createdAt DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([userId, purpose])
  @@map("email_tokens")
}

// ---------- Cart and addresses ----------

// A logged-in user's cart: one row per variant, with how many. There's no "carts" table: a
// user has exactly one cart, so their rows ARE the cart. Prices are NOT stored here: the cart
// always shows today's price, read from the variant.
model CartItem {
  id        String         @id @default(uuid(7)) @db.Uuid
  userId    String         @map("user_id") @db.Uuid
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  // A variant deleted by an admin simply disappears from carts
  variantId String         @map("variant_id") @db.Uuid
  variant   ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  quantity  Int // 1 to 10 (CHECK cart_items_quantity_range)
  createdAt DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)

  // One row per variant: adding the same thing again increases the quantity
  @@unique([userId, variantId])
  @@index([variantId])
  @@map("cart_items")
}

// Where orders are delivered. An order COPIES the address it was sent to, so editing or
// deleting an address later never changes a past order.
model Address {
  id        String   @id @default(uuid(7)) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  fullName  String   @map("full_name") @db.VarChar(100)
  phone     String   @db.VarChar(10) // 10 digits, no +91 (CHECK addresses_phone_format)
  line1     String   @db.VarChar(200)
  line2     String   @default("") @db.VarChar(200)
  city      String   @db.VarChar(100)
  state     String   @db.VarChar(60)
  pincode   String   @db.Char(6) // CHECK addresses_pincode_format
  // At most ONE default per user: a partial unique index in the migration
  // (UNIQUE (user_id) WHERE is_default), which Prisma can't express
  isDefault Boolean  @default(false) @map("is_default")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([userId])
  @@map("addresses")
}

// ---------- Orders ----------

enum OrderStatus {
  PENDING_PAYMENT
  PAID
  SHIPPED
  DELIVERED
  CANCELLED
  EXPIRED
  REFUNDED

  @@map("order_status")
}

// An order is a RECORD of what happened: names, prices and the address are COPIED in, so
// later changes to the catalog or the address book never rewrite history.
model Order {
  id              String      @id @default(uuid(7)) @db.Uuid
  // "SN000123", from a database SEQUENCE (a counter that never hands out the same number
  // twice, even to two orders placed at the same instant). Shown to shoppers instead of the id.
  number          String      @unique @default(dbgenerated("('SN'::text || lpad((nextval('order_number_seq'::regclass))::text, 6, '0'::text))")) @db.VarChar(20)
  // Orders are never deleted with a user: they're the shop's accounting records
  userId          String      @map("user_id") @db.Uuid
  user            User        @relation(fields: [userId], references: [id], onDelete: Restrict)
  status          OrderStatus @default(PENDING_PAYMENT)
  // From the Idempotency-Key header: the same key twice = the same order (see OrdersService)
  idempotencyKey  String      @map("idempotency_key") @db.VarChar(100)
  // A fingerprint of the request that used the key: the key can't be reused for a different one
  requestHash     String      @map("request_hash") @db.Char(64)
  shippingAddress Json        @map("shipping_address")
  // Paise. total = subtotal - discount + shipping_fee (CHECK orders_total_adds_up)
  subtotal        Int
  discount        Int         @default(0)
  shippingFee     Int         @map("shipping_fee")
  total           Int
  couponCode      String?     @map("coupon_code") @db.VarChar(30)
  // Pay before this, or the order expires and its stock goes back on sale
  expiresAt       DateTime?   @map("expires_at") @db.Timestamptz(3)
  paidAt          DateTime?   @map("paid_at") @db.Timestamptz(3)
  shippedAt       DateTime?   @map("shipped_at") @db.Timestamptz(3)
  deliveredAt     DateTime?   @map("delivered_at") @db.Timestamptz(3)
  cancelledAt     DateTime?   @map("cancelled_at") @db.Timestamptz(3)
  items           OrderItem[]
  createdAt       DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime    @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@unique([userId, idempotencyKey])
  // "My orders", newest first
  @@index([userId, id(sort: Desc)])
  // The expiry job: "unpaid orders past their time"
  @@index([status, expiresAt])
  @@map("orders")
}

model OrderItem {
  id          String          @id @default(uuid(7)) @db.Uuid
  orderId     String          @map("order_id") @db.Uuid
  order       Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  // Links back to the catalog while it still exists (for "buy again" and restocking);
  // the copies below keep the order readable after the product is gone
  variantId   String?         @map("variant_id") @db.Uuid
  variant     ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)
  productSlug String          @map("product_slug") @db.VarChar(220)
  productName String          @map("product_name") @db.VarChar(200)
  options     Json            @default("{}")
  sku         String?         @db.VarChar(64)
  imageUrl    String?         @map("image_url") @db.VarChar(2000)
  unitPrice   Int             @map("unit_price")
  quantity    Int
  lineTotal   Int             @map("line_total")
  position    Int             @default(0)

  @@index([orderId])
  @@index([variantId])
  @@map("order_items")
}
