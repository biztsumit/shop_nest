# Copy to .env and fill in. .env is never committed.
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/shop_nest?schema=public
PORT=4000
# The web app's address: the only origin allowed to call the API from a browser
WEB_ORIGIN=http://localhost:4100

# Optional (these are the defaults):
# LOG_LEVEL=info                # silent while testing
# RATE_LIMIT_PER_MINUTE=120     # requests per minute from one IP address
# TRUST_PROXY=loopback          # which proxies may report the client's IP (see README)

# Tests use their OWN database (the e2e tests refuse any name not ending in _test).
# Put this in apps/api/.env.test:
# DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/shop_nest_test?schema=public
# JWT_SECRET=<another long random value>

# Signs login tokens. Long and random, never committed:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
# ACCESS_TOKEN_MINUTES=15
# REFRESH_TOKEN_DAYS=30         # how long you stay logged in without visiting

# Emails (see README "Emails and passwords"):
# EMAIL_TRANSPORT=log           # log (files in .emails/) | brevo (really sends)
# BREVO_API_KEY=                # required when EMAIL_TRANSPORT=brevo
# EMAIL_FROM_ADDRESS=shop@example.com   # must be a sender verified in Brevo
# EMAIL_FROM_NAME=Shop
# EMAIL_REDIRECT_TO=            # send EVERY email here instead (safe testing with brevo)
# JOBS_ENABLED=true             # run background job workers in this process
# JOB_SCHEDULES_ENABLED=true    # timetabled jobs: expire orders (1 min), reconcile (5 min), clean-up (03:30)

# ORDER_PAYMENT_MINUTES=30      # unpaid orders hold their stock this long, then expire

# Payments (Razorpay Dashboard → Account & Settings → API Keys). Leave empty to turn online
# payment off. Test keys (rzp_test_...) take pretend payments. The secrets are never committed.
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=
# RAZORPAY_WEBHOOK_SECRET=      # set when you add the webhook (Settings → Webhooks)

# Observability (see README "Observability"). Both off when empty.
# METRICS_TOKEN=                # GET /api/metrics needs "Authorization: Bearer <this>" (16+ characters)
# SENTRY_DSN=                   # error tracking and tracing; read when started with --import ./dist/instrument.js
# SENTRY_TRACES_SAMPLE_RATE=0.1 # share of requests traced
