# Copy to .env and fill in. .env is never committed.
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/shop_nest?schema=public
PORT=4000
# The web app's address: the only origin allowed to call the API from a browser
WEB_ORIGIN=http://localhost:4100

# Optional (these are the defaults):
# LOG_LEVEL=info                # silent while testing
# RATE_LIMIT_PER_MINUTE=120     # requests per minute from one IP address
# TRUST_PROXY=loopback          # which proxies may report the client's IP (see README)

# Tests use their OWN database (the e2e tests refuse any name not ending in _test).
# Put this in apps/api/.env.test:
# DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/shop_nest_test?schema=public
