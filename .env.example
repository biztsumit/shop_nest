# Settings for `docker compose` (docker-compose.yml). Copy to .env and fill in; .env is never
# committed. (Running the apps WITHOUT Docker uses apps/api/.env and apps/web/.env instead.)

# The database password inside the compose network
POSTGRES_PASSWORD=
# Signs login tokens. Long and random:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=

# Optional
# WEB_ORIGIN=http://localhost:4100
# EMAIL_TRANSPORT=log           # or brevo (then BREVO_API_KEY and EMAIL_FROM_ADDRESS)
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=
# RAZORPAY_WEBHOOK_SECRET=
